{
  "name": "my-pastel-planner",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:text": "node scripts/text-check.mjs",
    "test:ink": "node scripts/ink-check.mjs",
    "test:touch": "node scripts/touch-check.mjs",
    "test:pinch": "node scripts/pinch-check.mjs",
    "test:custom": "node scripts/custom-check.mjs",
    "test:reliability": "node scripts/reliability-check.mjs",
    "test:turn": "node scripts/turn-check.mjs",
    "format": "prettier --write src scripts tests package.json tsconfig.json pnpm-workspace.yaml",
    "test:dock": "node scripts/dock-check.mjs",
    "test:keyboard": "node scripts/keyboard-check.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "page-flip": "2.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
